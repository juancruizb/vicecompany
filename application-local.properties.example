# Copiar este archivo como application-local.properties (misma carpeta) y completar.
# application-local.properties está en .gitignore: nunca se sube a GitHub.
#
# Usar el usuario "vicecompany" (scripts/create-sql-user.sql), nunca "sa": solo lee las
# columnas que usa la aplicación y solo actualiza Vice/Cía de los tickets.

spring.datasource.url=jdbc:sqlserver://HOST:PUERTO;databaseName=servicedesk;encrypt=true;trustServerCertificate=true
spring.datasource.username=vicecompany
spring.datasource.password=CONTRASENA

vice.servicedesk.url=https://HOST_SERVICEDESK

# false = solo lectura (recomendado para la primera prueba).
vice.sincronizacion.habilitada=false

# Sincronización automática: "-" = apagada; "0 0 * * * *" = cada hora en punto.
vice.sincronizacion.cron=-

# Log en archivo (útil cuando corre como servicio, sin ventana).
logging.file.name=logs/vicecompany.log
